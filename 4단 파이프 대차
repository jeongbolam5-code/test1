
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>4단 파이프 대차</title>
<style>
    body {
        font-family: "Malgun Gothic", sans-serif;
        margin: 30px;
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    th, td {
        border: 1px solid #333;
        text-align: center;
        padding: 8px;
        height: 28px;
        font-size: 14px;
    }

    th {
        background-color: #D9E2F3;
        font-weight: bold;
    }

    th:nth-child(1) { width: 7%; }
    th:nth-child(2) { width: 16%; }
    th:nth-child(3) { width: 23%; }
    th:nth-child(4) { width: 32%; }
    th:nth-child(5) { width: 22%; }

    @media print {
        body { margin: 10mm; }
        tr { page-break-inside: avoid; }
    }
</style>
</head>
<body>

<h2>4단 파이프 대차</h2>

<table>
    <thead>
        <tr>
            <th>순</th>
            <th>차종</th>
            <th>품번</th>
            <th>품명</th>
            <th>적입수량</th>
        </tr>
    </thead>
    <tbody id="tableBody"></tbody>
</table>

<script>
const tbody = document.getElementById("tableBody");

for (let i = 1; i <= 28; i++) {
    const row = document.createElement("tr");

    // 순번 자동 입력
    const numberCell = document.createElement("td");
    numberCell.textContent = i;
    row.appendChild(numberCell);

    // 나머지 4개 열 생성
    for (let j = 0; j < 4; j++) {
        const cell = document.createElement("td");
        cell.contentEditable = "true";
        row.appendChild(cell);
    }

    tbody.appendChild(row);
}
</script>

</body>
</html>
